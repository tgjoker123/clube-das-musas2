generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusAluna {
  ativa
  suspensa
  inadimplente
}

enum StatusCheckIn {
  pendente
  concluido
}

model Lead {
  id        String   @id @default(uuid())
  nome      String
  email     String
  telefone  String
  mensagem  String?
  createdAt DateTime @default(now())

  @@map("leads")
}

model Professor {
  id         String   @id @default(uuid())
  authUserId String   @unique
  nome       String
  email      String   @unique
  status     String   @default("ativo")
  valorMensalidade Decimal?
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())

  alunas      Aluna[]
  exercicios  Exercicio[]
  fichas      FichaTreino[]

  @@map("professores")
}

model Aluna {
  id           String      @id @default(uuid())
  professorId  String
  authUserId   String?     @unique
  nome         String
  email        String
  dataNascimento DateTime
  status       StatusAluna @default(ativa)
  dataEntrada  DateTime    @default(now())
  observacoes  String?
  createdAt    DateTime    @default(now())

  professor      Professor        @relation(fields: [professorId], references: [id], onDelete: Cascade)
  anamneses      Anamnese[]
  exames         ExameSangue[]
  evolucoes      EvolucaoFisica[]
  fichas         FichaAluna[]
  checkIns       CheckIn[]

  @@index([professorId])
  @@map("alunas")
}

model Anamnese {
  id            String   @id @default(uuid())
  alunaId       String
  respostasJson Json
  data          DateTime @default(now())

  aluna Aluna @relation(fields: [alunaId], references: [id], onDelete: Cascade)

  @@index([alunaId])
  @@map("anamneses")
}

model ExameSangue {
  id         String   @id @default(uuid())
  alunaId    String
  arquivoUrl String
  dataExame  DateTime

  aluna Aluna @relation(fields: [alunaId], references: [id], onDelete: Cascade)

  @@index([alunaId])
  @@map("exames_sangue")
}

model EvolucaoFisica {
  id          String   @id @default(uuid())
  alunaId     String
  fotoUrl     String?
  peso        Decimal?
  medidasJson Json?
  data        DateTime @default(now())

  aluna Aluna @relation(fields: [alunaId], references: [id], onDelete: Cascade)

  @@index([alunaId])
  @@map("evolucao_fisica")
}

model Exercicio {
  id            String  @id @default(uuid())
  professorId   String
  nome          String
  grupoMuscular String
  videoUrl      String?
  instrucoes    String?

  professor       Professor         @relation(fields: [professorId], references: [id], onDelete: Cascade)
  itensFicha      FichaTreinoItem[]
  checkIns        CheckIn[]

  @@index([professorId])
  @@map("exercicios")
}

model FichaTreino {
  id           String @id @default(uuid())
  professorId  String
  nomeTemplate String

  professor Professor         @relation(fields: [professorId], references: [id], onDelete: Cascade)
  itens     FichaTreinoItem[]
  alunas    FichaAluna[]

  @@index([professorId])
  @@map("fichas_treino")
}

model FichaTreinoItem {
  id          String  @id @default(uuid())
  fichaId     String
  exercicioId String
  series      Int
  reps        String
  carga       String?

  ficha     FichaTreino @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  exercicio Exercicio   @relation(fields: [exercicioId], references: [id], onDelete: Cascade)

  @@index([fichaId])
  @@index([exercicioId])
  @@map("ficha_treino_itens")
}

model FichaAluna {
  id              String   @id @default(uuid())
  alunaId         String
  fichaTreinoId   String
  dataAssociacao  DateTime @default(now())

  aluna       Aluna       @relation(fields: [alunaId], references: [id], onDelete: Cascade)
  fichaTreino FichaTreino @relation(fields: [fichaTreinoId], references: [id], onDelete: Cascade)

  @@index([alunaId])
  @@index([fichaTreinoId])
  @@map("ficha_aluna")
}

model CheckIn {
  id          String        @id @default(uuid())
  alunaId     String
  exercicioId String
  data        DateTime      @default(now())
  fotoUrl     String?
  status      StatusCheckIn @default(pendente)

  aluna     Aluna     @relation(fields: [alunaId], references: [id], onDelete: Cascade)
  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)

  @@index([alunaId])
  @@index([exercicioId])
  @@map("check_ins")
}
