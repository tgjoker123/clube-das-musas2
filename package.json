{
  "name": "clube-das-musas",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "pnpm --filter @musas/database run generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "generate": "turbo run generate",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-unknown"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "prettier": "@musas/config/prettier",
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@musas/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "2.8.17",
    "typescript": "^5.7.2"
  }
}
