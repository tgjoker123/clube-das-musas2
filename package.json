{
  "name": "clube-das-musas",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @musas/database run generate",
    "dev:api": "pnpm --filter @musas/api run start:dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-unknown"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
